# Anthropic Claude API Key
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AGENT=claude-3-7-sonnet-20250219

# PostgreSQL with pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartcampus
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Voyage AI Embeddings
VOYAGE_API_KEY=your-voyage-api-key-here
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# SmartCampus Gateway Backend
BACKEND_BASE_URL=http://localhost:8000/api
BACKEND_SERVICE_TOKEN=your-service-token-here

# Audit log directory
AUDIT_OUTPUT_DIR=./output

# Agent constraints
EVALUATE_TIMEOUT_SECONDS=25
MAX_REACT_STEP=6
MAX_REFLECT_STEP=3
MAX_RAG_CALLS=5
CONFIDENCE_THRESHOLD=0.5
