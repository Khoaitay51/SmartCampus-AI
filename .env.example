# =============================================================================
# SmartCampus AI - Environment Configuration Example
# =============================================================================

# LLM Provider: 'ollama', 'gemini' hoặc 'deepseek'
LLM_PROVIDER=ollama
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=4096

# OpenAI / GPT Configuration (or compatible proxy)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic / Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_MAX_TOKENS=4096
AGENT=gemini-3.6-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Local Service (SLM Qwen + Nomic Embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_FALLBACK_MODEL=qwen2:1.5b
OLLAMA_NUM_CTX=32768

# PostgreSQL + pgvector (Port 5433 trên host tránh trùng Edge DB 5434)
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://smartcampus:change-this-local-password@localhost:5433/smartcampus
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Embedding Config
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
VOYAGE_API_KEY=

# Backend & RAG Gateway (Edge Gateway Service)
BACKEND_BASE_URL=http://localhost:8000
GATEWAY_BASE_URL=http://localhost:8000/api
BACKEND_SERVICE_TOKEN=
USE_MOCK_RAG=false

# Audit & Agent Controls
AUDIT_OUTPUT_DIR=./output
EVALUATE_TIMEOUT_SECONDS=25
MAX_REACT_STEP=6
MAX_REFLECT_STEP=3
MAX_RAG_CALLS=5
CONFIDENCE_THRESHOLD=0.5

# JWT Authentication
SECRET_KEY=smartcampus-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# MQTT Broker (for WebSocket tunnel bridge)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=smartcampus
MQTT_PASSWORD=123456
MQTT_CLIENT_ID=smartcampus-fastapi-bridge
